# ============================================================
# Sanity CMS (required - free at sanity.io)
# Create: npx sanity manage  OR  https://www.sanity.io/manage
# ============================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01
# Set "true" only if your dataset is public. If you use API tokens, leave false.
NEXT_PUBLIC_SANITY_USE_CDN=false

# Required so the website can place orders (orders are saved in Sanity).
# Create a token at sanity.io/manage -> API -> Tokens -> Add API Token
# with View + Edit permissions. It is only used server-side.
SANITY_API_WRITE_TOKEN=your-write-token

# Optional: use a separate read-only token when your dataset is private.
SANITY_API_READ_TOKEN=

# Optional webhook secret used at /api/revalidate. Set the same value as
# the Secret in your Sanity webhook (dataset document.create/update/delete
# events -> POST to https://YOUR-VERCEL-URL/api/revalidate).
SANITY_REVALIDATE_SECRET=

# ============================================================
# Khalti (options: LIVE or TEST)
# Test keys: https://docs.khalti.com (dev khalti)
# ============================================================
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=your-live-public-key
KHALTI_SECRET_KEY=your-live-secret-key
# LIVE defaults are used when these are left empty:
#   Initiate: https://khalti.com/api/v2/epayment/initiate/
#   Lookup:   https://khalti.com/api/v2/epayment/lookup/
# For testing uncomment:
#NEXT_PUBLIC_KHALTI_PAYMENT_ENDPOINT=https://dev.khalti.com/api/v2/epayment/initiate/
#KHALTI_LOOKUP_ENDPOINT=https://dev.khalti.com/api/v2/epayment/lookup/

# ============================================================
# eSewa (options: LIVE or TEST)
# For live you need an eSewa merchant access (service code, SCD).
# ============================================================
NEXT_PUBLIC_ESEWA_MERCHANT_ID=your-esewa-service-code
# LIVE defaults are used when left empty:
# Gateway: https://esewa.com.np/epay/main
# Verify:  https://esewa.com.np/epay/transrec
# For testing uncomment:
#NEXT_PUBLIC_ESEWA_GATEWAY_URL=https://uat.esewa.com.np/epay/main
#ESEWA_VERIFY_URL=https://uat.esewa.com.np/epay/transrec

# ============================================================
# Site URL - used in payment return URLs (must be public).
# ============================================================
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app